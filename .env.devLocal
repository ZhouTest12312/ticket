# 开发环境接口地址
VITE_API_URL=/api

# 本地联调：/api/trade/v1/* → campus-trade（login/usercenter 仍走测试网关）
VITE_TRADE_BASE=trade
# VITE_CAMPUS_PROXY_TARGET=http://127.0.0.1:9952

# 工单系统本地后端（设置后 /api 全部代理到 FastAPI）
VITE_TICKET_PROXY_TARGET=http://127.0.0.1:8000
VITE_USE_TICKET_API=true

# 生产环境配置
VITE_APP_ENV=devLocal

VITE_APP_SISHU_H5='https://test-h5.jhss.vip'

# 秋季交易分笔支付 H5 基址（未配置时仅创建支付单，前端暂不生成可扫码链接）
# 拼接规则：{base}?orderId={orderId}&paymentId={paymentId}
# VITE_APP_TRADE_H5_PAY_BASE=https://example.com/user/order/pay

# 开发 Mock：逗号分隔模块 key，或 all 启用全部；留空则全走真实接口
# 模块 key 见 src/mock/registry.js
# trialOrder：试听整模块 Mock（班级/课次/试算/创建）；联调 campus-trade 时勿包含
# formalOrder：正式下单 Mock；联调时勿包含
# settlementTransferOrder：结转换班 Mock；联调 campus-trade 时勿包含
# withdrawClassOrder：退班 · 发起退款工单 Mock；联调 campus-trade 时勿包含
# tradeOfflinePayment：仅列表「线下支付申请」Drawer Mock
# tradeOperationPayments：分笔支付全局 Mock（旧配置，慎用；含列表线上支付 + 创建成功页）
VITE_API_MOCK=classStudentList,addReportOrder,classroomManagement,settlementTransferOrder,withdrawClassOrder,tradeOfflinePayment
