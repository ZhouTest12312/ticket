  "private": true,
  "scripts": {
    "dev": "vite --host --mode devLocal",
    "dev:test": "vite --host --mode testLocal",
    "serve": "vite build && vite preview --host",
    "build:dev": "vite build --mode dev",
    "build:test": "vite build --mode test",
    "build:uat": "vite build --mode uat",
